APP_ENV=development
DATABASE_URL=sqlite:///./data/campus.db
PUBLIC_BASE_URL=http://127.0.0.1:15001
VERIFY_BASE_URL=http://127.0.0.1:15002
DATA_DIR=./data
COOKIE_SECURE=false
TRUSTED_PROXIES=
MAX_PDF_MB=200
MAX_PDF_COUNT_PER_APPLICATION=5
MAX_PHOTO_MB=10
MAX_PHOTO_COUNT=10
INVITE_FIRST_SUBMIT_DAYS=7
INVITE_RESULT_AFTER_PERMIT_DAYS=30
INVITE_UNISSUED_RESULT_DAYS=30
VISIT_LOG_RETENTION_DAYS=360
# Production: inject PostgreSQL URL and BASE_URLs. Set COOKIE_SECURE=true behind HTTPS.
# FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
